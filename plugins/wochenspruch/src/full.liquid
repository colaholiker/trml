<!-- Hier wird der Fallback definiert: Wenn Tag (idx_0) existiert, nimm ihn, sonst die Woche (idx_1) -->
{% assign tag = IDX_0.data %}
{% assign woche = IDX_1.data %}

{% if tag.Titel != json.undefined and tag.Titel != null and tag.Titel != "" %}
  {% assign info = tag %}
  {% assign anzeige_typ = "Feiertag" %}
{% else %}
  {% assign info = woche %}
  {% assign anzeige_typ = "Wochenübersicht" %}
{% endif %}

<div class="layout layout--col">
  <!-- Kopfzeile -->
  <div class="header">
    <span class="title title--large">{{ info.Titel }}</span>
    <span class="meta">{{ info.Festzeit }} • {{ info["liturgische Farbe"] }}</span>
  </div>

  <div class="content grid grid--2col">
    <!-- Linke Spalte -->
    <div class="section col">
      <div class="item">
        <span class="label">Wochenspruch ({{ info.Wochenspruch }})</span>
        <span class="value text--italic">„{{ info.Wochenspruch-Text }}“</span>
      </div>
      <div class="item" style="margin-top: 10px;">
        <span class="label">Kernaussage</span>
        <span class="text--small">{{ info.Kernaussage }}</span>
      </div>
    </div>

    <!-- Rechte Spalte -->
    <div class="section col" style="border-left: 1px solid #ccc; padding-left: 15px;">
      <span class="label">Liturgische Texte ({{ anzeige_typ }})</span>
      
      <div class="bible-reading">
        <span class="bible-label">Evangelium:</span>
        <span class="bible-value">{{ info.Evangelium }}</span>
      </div>
      
      <div class="bible-reading">
        <span class="bible-label">Predigttext (Reihe {{ info.Reihe }}):</span>
        <span class="bible-value">{{ info.Predigttext }}</span>
      </div>

      <div class="bible-reading">
        <span class="bible-label">Epistel:</span>
        <span class="bible-value">{{ info.Epistel }}</span>
      </div>
      
      <div class="bible-reading">
        <span class="bible-label">AT-Lesung:</span>
        <span class="bible-value">{{ info.AT-Lesung }}</span>
      </div>

      <div class="bible-reading" style="margin-top: 10px;">
        <span class="bible-label">Wochenlied:</span>
        <span class="bible-value text--bold">{{ info.Wochenlied }}</span>
      </div>
    </div>
  </div>
  
  <!-- Fußzeile -->
  <div class="footer">
    <span>Gültig für: {{ info["Datum lang"] }}</span>
  </div>
</div>
