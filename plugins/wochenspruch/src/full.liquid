<style>
.wochenspruch {
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 100vh;
  max-height: 100%;
  padding: 2rem;
  color: white;
}
</style>


{% assign tag = IDX_0.data[0] %}
{% assign woche = IDX_1.data[0] %}

{% assign info = woche %}
{% assign anzeige_typ = "Wochenübersicht" %}

{% if tag.Titel != nil and tag.Titel != blank %}
  {% assign info = tag %}
  {% assign anzeige_typ = "Feiertag" %}
{% endif %}

<div class="wochenspruch"
  {% if info["Wochenspruch-Bild"] != blank %}
    style="background-image: url('{{ info["Wochenspruch-Bild"] }}');"
  {% endif %}>

  <!--
    <h2>{{ info.Titel }}</h2>
    <p>{{ info["Datum lang"] }}</p>
  -->
  
</div>