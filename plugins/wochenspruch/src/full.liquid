<!-- Hier wird der Fallback definiert: Wenn Tag (IDX_0) existiert, nimm ihn, sonst die Woche (IDX_1) -->
{% assign tag = IDX_0.data[0] %}
{% assign woche = IDX_1.data[0] %}

{% if tag and tag.Titel and tag.Titel != "" %}
  {% assign info = tag %}
  {% assign anzeige_typ = "Feiertag" %}
{% else %}
  {% assign info = woche %}
  {% assign anzeige_typ = "Wochenübersicht" %}
{% endif %}

<!-- Testausgabe -->
{{ info.Titel }} ({{ anzeige_typ }})
{{ info["Datum lang"] }}

{{info}}